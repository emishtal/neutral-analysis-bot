# Telegram Bot Token (получить у @BotFather)
TELEGRAM_TOKEN=your_telegram_bot_token_here

# GigaChat API Credentials (получить на developers.sber.ru)
GIGACHAT_CLIENT_ID=your_client_id_here
GIGACHAT_CLIENT_SECRET=your_client_secret_here
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Database
DATABASE_PATH=database.db

# ЮKassa (для платежей - пока не используется)
# YUKASSA_SHOP_ID=your_shop_id
# YUKASSA_SECRET_KEY=your_secret_key

# Admin
ADMIN_USERNAME=your_support
